@model HTNLShop.ViewModels.TrangChuVM

<section class="home-hero">
    <div class="container home-hero__inner">
        <div class="home-hero__copy">
            <p class="home-hero__eyebrow"><span></span> HTNL / PC &amp; LINH KIỆN</p>
            <h1>Mỗi cấu hình,<br><em>một cá tính.</em></h1>
            <p class="home-hero__description">Tìm chiếc laptop hợp gu, nâng cấp bộ PC của bạn — bắt đầu từ đúng món linh kiện cần thiết.</p>
            <form asp-action="Search" asp-controller="SanPham" method="get" class="home-hero__search">
                <label class="visually-hidden" for="homeProductSearch">Tìm kiếm sản phẩm</label>
                <i class="fas fa-search" aria-hidden="true"></i>
                <input id="homeProductSearch" type="search" name="query" placeholder="Thử “card màn hình”, “laptop”..." required>
                <button type="submit">Tìm ngay <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i></button>
            </form>
            <a class="home-hero__browse" href="#home-products">Khám phá sản phẩm <i class="fas fa-arrow-down ms-2" aria-hidden="true"></i></a>
        </div>
        <div class="home-hero__visual">
            <div class="home-hero__image-frame">
                <img src="~/Assets/img/Products/2/48.jpg" alt="Bộ PC gaming với hệ thống đèn RGB" width="640" height="480">
                <span class="home-hero__image-index">01 <span>/</span> BUILD YOUR WAY</span>
            </div>
            <a asp-controller="SanPham" asp-action="Index" asp-route-id="2" class="home-hero__feature">
                <span class="home-hero__feature-icon"><i class="fas fa-external-link-alt" aria-hidden="true"></i></span>
                <span><small>GÓC KHÁM PHÁ</small><strong>PC &amp; linh kiện</strong></span>
                <i class="fas fa-arrow-right home-hero__feature-arrow" aria-hidden="true"></i>
            </a>
            <span class="home-hero__orbit" aria-hidden="true">H</span>
        </div>
        <div class="home-hero__signature" aria-hidden="true">BUILD<br>WHAT<br>MOVES YOU</div>
    </div>
</section>

<section class="home-products container" id="home-products">
    <div class="home-products__heading">
        <div>
            <p class="home-section-eyebrow">CHỌN MÓN BẠN ĐANG TÌM</p>
            <h2>Sản phẩm bán chạy</h2>
        </div>
        <p class="home-products__note">Được sắp xếp theo danh mục<br>để bạn tìm nhanh hơn.</p>
    </div>

    @if (!Model.Categories.Any())
    {
        <div class="home-products__empty">
            <p class="mb-3">Chưa có sản phẩm bán chạy trong tháng này.</p>
            <a asp-controller="SanPham" asp-action="Index" class="btn btn-primary rounded-pill px-4">Khám phá tất cả sản phẩm</a>
        </div>
    }
    else
    {
        <div class="tab-class">
            <ul class="nav nav-pills home-category-tabs" role="tablist">
                @for (int i = 0; i < Model.Categories.Count; i++)
                {
                    var category = Model.Categories[i];
                    <li class="nav-item" role="presentation">
                        <a class="nav-link @(i == 0 ? "active" : "")"
                           id="category-tab-@category.CategoryId"
                           data-bs-toggle="pill"
                           href="#tab-@category.CategoryId"
                           role="tab"
                           aria-controls="tab-@category.CategoryId"
                           aria-selected="@(i == 0 ? "true" : "false")">
                            <span class="home-category-tabs__index">0@(i + 1)</span>
                            @category.CategoryName
                            <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>

            <div class="tab-content home-products__content">
                @for (int i = 0; i < Model.Categories.Count; i++)
                {
                    var category = Model.Categories[i];
                    <div id="tab-@category.CategoryId" class="tab-pane fade @(i == 0 ? "show active" : "") p-0" role="tabpanel" aria-labelledby="category-tab-@category.CategoryId">
                        <h3 class="home-products__category-title">@category.CategoryName <span>— được yêu thích tại HTNL</span></h3>
                        <div class="row g-4">
                            @foreach (var product in category.TopProducts)
                            {
                                <div class="col-md-6 col-lg-4 col-xl-3 product-grid-item">
                                    <div class="rounded position-relative fruite-item">
                                        <span class="badge home-product-rank position-absolute" style="top: 10px; right: 10px; z-index: 10;">
                                            #@(category.TopProducts.IndexOf(product) + 1)
                                        </span>
                                        <div class="fruite-img">
                                            <a asp-controller="SanPham" asp-action="Detail" asp-route-id="@product.ProductId">
                                                <img src="~/Assets/img/Products/@product.CategoryId/@(product.ProductId).jpg"
                                                     class="img-fluid w-100 rounded-top" alt="@product.ProductName" loading="lazy" width="640" height="480">
                                            </a>
                                        </div>
                                        <span class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">
                                            @product.CategoryName
                                        </span>
                                        <div class="p-4 border border-secondary border-top-0 rounded-bottom">
                                            <a asp-controller="SanPham" asp-action="Detail" asp-route-id="@product.ProductId">
                                                <h4 class="truncate-title">@product.ProductName</h4>
                                            </a>
                                            <p class="truncate-detail">@product.ProductDetail</p>
                                            <div class="mb-2">
                                                <span class="badge home-product-sold">
                                                    <i class="fa fa-fire" aria-hidden="true"></i> Đã bán: @product.TotalQuantitySold
                                                </span>
                                            </div>
                                            <div class="d-flex justify-content-between flex-lg-wrap">
                                                <p class="text-dark fs-5 fw-bold mb-0">@String.Format("{0:N0} đ", product.Price)</p>
                                                @if (product.StockQuantity > 0)
                                                {
                                                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@product.ProductId"
                                                       class="btn border border-secondary rounded-pill px-3 text-primary">
                                                        <i class="fa fa-shopping-bag me-2 text-primary" aria-hidden="true"></i> Thêm vào giỏ hàng
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-secondary rounded-pill px-3" disabled>Hết hàng</button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</section>
