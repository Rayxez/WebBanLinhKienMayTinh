<footer class="container-fluid bg-dark text-white-50 footer pt-5 mt-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-4 col-md-6">
                <a asp-controller="TrangChu" asp-action="Index" class="text-decoration-none">
                    <span class="h2 text-primary fw-bold">HTNL.Shop</span>
                </a>
                <p class="mt-3 mb-4">Tìm laptop, PC và linh kiện phù hợp với cấu hình bạn đang cần.</p>
                <a asp-controller="SanPham" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2">Khám phá sản phẩm</a>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="d-flex flex-column text-start footer-item">
                    <h4 class="text-light mb-3">Mua sắm</h4>
                    <a class="btn-link" asp-controller="SanPham" asp-action="Index">Tất cả sản phẩm</a>
                    <a class="btn-link" asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn-link" asp-controller="Order" asp-action="Index">Lịch sử mua hàng</a>
                        <a class="btn-link" asp-controller="Customer" asp-action="ProFile">Hồ sơ của tôi</a>
                    }
                    else
                    {
                        <a class="btn-link" asp-controller="Customer" asp-action="Login">Đăng nhập để xem đơn hàng</a>
                        <a class="btn-link" asp-controller="Customer" asp-action="Register">Tạo tài khoản</a>
                    }
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <div class="d-flex flex-column text-start footer-item">
                    <h4 class="text-light mb-3">Hỗ trợ</h4>
                    <a class="btn-link" asp-controller="LienHe" asp-action="LienHe">Liên hệ với shop</a>
                    <a class="btn-link" href="mailto:htnlshop@gmail.com">Gửi email</a>
                    <a class="btn-link" href="tel:+088866669999">Gọi hotline</a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="footer-item">
                    <h4 class="text-light mb-3">HTNL.Shop</h4>
                    <p><i class="fas fa-map-marker-alt me-2 text-secondary" aria-hidden="true"></i>218 Lĩnh Nam, Hoàng Mai, Hà Nội</p>
                    <p><i class="fas fa-envelope me-2 text-secondary" aria-hidden="true"></i><a href="mailto:htnlshop@gmail.com">htnlshop@gmail.com</a></p>
                    <p><i class="fas fa-phone-alt me-2 text-secondary" aria-hidden="true"></i><a href="tel:+088866669999">+0888 6666 9999</a></p>
                    <p class="mb-0">Thứ Hai – Thứ Bảy: 8:00 – 18:00</p>
                </div>
            </div>
        </div>
    </div>
</footer>
