@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container py-5 text-center">
    <div class="display-1 text-warning fw-bold">403</div>
    <h2 class="mb-3">Bạn không có quyền truy cập trang này</h2>
    <p class="text-muted mb-4">
        Khu vực này chỉ dành cho tài khoản quản trị. Nếu bạn cho rằng đây là nhầm lẫn,
        hãy đăng nhập bằng tài khoản có quyền phù hợp.
    </p>
    <a asp-controller="TrangChu" asp-action="Index" class="btn btn-primary">Về trang chủ</a>
    <a asp-controller="Customer" asp-action="Login" class="btn btn-outline-secondary ms-2">Đăng nhập</a>
</div>
