@using HTNLShop.ViewModels

@model HTNLShop.ViewModels.ProductDetailVM
@{
    ViewData["Title"] = Model.ProductName;
}


<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Chi tiết sản phẩm</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="TrangChu" asp-action="Index">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="SanPham" asp-action="Index">Sản Phẩm</a></li>
        <li class="breadcrumb-item active text-white">@Model.ProductName</li>
    </ol>
</div>

@section Scripts {
    <script>
        $(document).on("submit", "#reviewForm", function (event) {
            event.preventDefault();
            const form = $(this);

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function (result) {
                    $("#reviewList").html(result);
                    form.find("textarea[name='Content']").val("");
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || "Không thể gửi đánh giá. Vui lòng thử lại.";
                    alert(message);
                }
            });
        });
    </script>
}
<div class="container-fluid py-5 mt-5">
    <div class="container py-5">
        <div class="row g-4 mb-5">
            <div class="col-lg-8 col-xl-9">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="border rounded">
                            <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/img/hero-img.jpg" : Model.ImageUrl)"
                                 class="img-fluid rounded" alt="@Model.ProductName" width="600" height="400" />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h4 class="fw-bold mb-3">@Model.ProductName</h4>
                        <p class="mb-3">Danh Mục: @Model.CategoryName</p>
                        <h5 class="fw-bold mb-3">@string.Format("{0:N0}", @Model.Price) đ</h5>
                        <p class="mb-4">@Model.ProductDetail</p>
                 
                        @if (Model.StockQuantity > 0)
                        {
                        <form asp-action="AddToCart" asp-controller="Cart" asp-route-id="@Model.ProductId" method="get">
                        <div class="input-group quantity mb-4" style="width: 120px;">
                            <div class="input-group-btn">
                                <button class="btn btn-sm btn-minus rounded-circle bg-light border" type="button" aria-label="Giảm số lượng">
                                    <i class="fa fa-minus" aria-hidden="true"></i>
                                </button>
                            </div>
                            <input type="number" class="form-control form-control-sm text-center border-0" value="1" min="1" max="@Model.StockQuantity" name="quantity" aria-label="Số lượng" required>
                            <div class="input-group-btn">
                                <button class="btn btn-sm btn-plus rounded-circle bg-light border" type="button" aria-label="Tăng số lượng">
                                    <i class="fa fa-plus" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                            <p class="small text-muted mb-3">Còn @Model.StockQuantity sản phẩm</p>
                            <button type="submit" class="btn border border-secondary rounded-pill px-4 py-2 mb-4 text-primary"><i class="fa fa-shopping-bag me-2 text-primary" aria-hidden="true"></i>Thêm Vào Giỏ Hàng</button>
                        </form>
                        }
                        else
                        {
                            <p class="text-danger fw-semibold">Sản phẩm hiện đã hết hàng.</p>
                            <button type="button" class="btn btn-secondary rounded-pill px-4 py-2 mb-4" disabled>Hết hàng</button>
                        }
                    </div>

                    <div class="col-lg-12 mt-5">
                        <nav>
                            <div class="nav nav-tabs mb-3">
                                <button class="nav-link active border-white border-bottom-0"
                                        data-bs-toggle="tab" data-bs-target="#tab-des">
                                    Mô Tả
                                </button>
                                
                                <button class="nav-link border-white border-bottom-0"
                                        data-bs-toggle="tab" data-bs-target="#tab-review">
                                    Đánh Giá
                                </button>
                             
                            </div>
                        </nav>

                        <div class="tab-content mb-5">
                   
                            <div class="tab-pane fade show active" id="tab-des">
                                <p>@Model.ProductDetail</p>
                            </div>
                            <div class="tab-pane fade" id="tab-review">
                                <h4 class="fw-bold mb-4">Đánh Giá Sản Phẩm(@ViewBag.quantity)</h4>

                                <div class="mb-4">
                                    @await Html.PartialAsync("~/Views/Review/_ReviewForm.cshtml",
                                             new ReviewVM { ProductId = Model.ProductId })
                                </div>                           
                                <div id="reviewList">
                                    @await Html.PartialAsync("~/Views/Review/_ListReview.cshtml",
                                             Model.Reviews)
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-xl-3">
                <div class="row g-4 fruite">
                    <div class="col-lg-12">
                        <form asp-action="Search" asp-controller="SanPham" method="get" class="input-group w-100 mx-auto d-flex mb-4">
                            <label for="detailSearch" class="visually-hidden">Tìm kiếm sản phẩm</label>
                            <input id="detailSearch" name="query" type="search" class="form-control p-3" placeholder="Tìm kiếm sản phẩm">
                            <button type="submit" class="input-group-text" aria-label="Tìm kiếm"><i class="fa fa-search" aria-hidden="true"></i></button>
                        </form>
						@await Component.InvokeAsync("Category")
                    </div>
                  
                </div>
            </div>
        </div>
        <h1 class="fw-bold mb-0">Sản Phẩm Cùng Danh Mục</h1>
        <div class="vesitable">
            <div class="owl-carousel vegetable-carousel justify-content-center">
                @foreach (var item in Model.SameCategoryProduct)
                {
                    <div class="border border-primary rounded position-relative vesitable-item">
                        <div class="vesitable-img">
                            <a asp-controller="SanPham" asp-action="Detail" asp-route-id="@item.ProductId">
                                <img src="~/Assets/img/Products/@item.CategoryId/@(item.ProductId).jpg" class="img-fluid w-100 rounded-top" alt="">
                            </a>
                        </div>
                        <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; right: 10px;">@item.CategoryName</div>
                        <div class="p-4 pb-0 rounded-bottom">
                            <a asp-controller="SanPham" asp-action="Detail" asp-route-id="@item.ProductId">
                                <h4 class="truncate-title">@item.ProductName</h4>
                            </a>
                            <p class="truncate-detail">@item.ProductDetail</p>
                            <div class="d-flex justify-content-between flex-lg-wrap">
                                <p class="text-dark fs-5 fw-bold mb-0">@String.Format("{0:N0} đ", item.Price)</p>
                                <a asp-controller="SanPham" asp-action="Detail" asp-route-id="@item.ProductId" class="btn border border-secondary rounded-pill px-3 py-1 mb-4 text-primary">
                                    <i class="fa fa-shopping-bag me-2 text-primary"></i> Xem Sản Phẩm
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
