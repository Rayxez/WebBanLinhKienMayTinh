@model IEnumerable<HTNLShop.ViewModels.ProductVM>

@foreach (var item in Model)
{
    <div class="col-md-6 col-lg-6 col-xl-4 product-grid-item">
        <div class="rounded position-relative fruite-item">
            <div class="fruite-img">
                <a asp-action="Detail" asp-controller="SanPham" asp-route-id="@item.ProductId">
                <img src="~/Assets/img/Products/@item.CategoryId/@(item.ProductId).jpg"
                     class="img-fluid w-100 rounded-top" alt="@item.ProductName" loading="lazy" width="640" height="480">
                </a>
            </div>
            <div class="text-white bg-secondary px-3 py-1 rounded position-absolute"
                 style="top: 10px; left: 10px;">
                @item.CategoryName
            </div>

            <div class="p-4 border border-secondary border-top-0 rounded-bottom">
                <a asp-action="Detail" asp-controller="SanPham" asp-route-id="@item.ProductId">
                <h4 class="truncate-title">@item.ProductName</h4>
				</a>
                <p class="truncate-detail">@item.ProductDetail</p>
                <div class="d-flex justify-content-between flex-lg-wrap">
                    <p class="text-dark fs-5 fw-bold mb-0">@String.Format("{0:N0} đ", item.Price)</p>

                    <a asp-action="AddToCart" asp-controller ="Cart" asp-route-id ="@item.ProductId" class="btn border border-secondary rounded-pill px-3 text-primary">
                        <i class="fa fa-shopping-bag me-2 text-primary" aria-hidden="true"></i> Thêm giỏ hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
}
